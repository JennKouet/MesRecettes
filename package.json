{
  "name": "mes-recettes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "//dependenciesMeta": "Yarn 4 desactive les scripts de build des dependances par defaut (protection supply-chain). Allowlist explicite des paquets qui en ont reellement besoin : binaires natifs et telechargement des moteurs Prisma.",
  "dependenciesMeta": {
    "@prisma/engines": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "prisma": {
      "built": true
    },
    "sharp": {
      "built": true
    },
    "unrs-resolver": {
      "built": true
    }
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "5.7.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
