# Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est gitignoré — n'y mettez jamais de secret dans `.env.example`.

# ── Base de données ────────────────────────────────────────────
# DATABASE_URL : utilisé par l'application, via le driver adapter (src/lib/db.ts)
# DIRECT_URL   : utilisé par le CLI Prisma (migrations), via prisma.config.ts
# En local les deux pointent au même endroit ; sur Neon, DATABASE_URL vise
# l'hôte *-pooler* et DIRECT_URL l'hôte direct (sinon `migrate` échoue sur
# des advisory locks).
DATABASE_URL="postgresql://mesrecettes:mesrecettes@localhost:5433/mesrecettes?schema=public"
DIRECT_URL="postgresql://mesrecettes:mesrecettes@localhost:5433/mesrecettes?schema=public"

# Production (Neon) :
# DATABASE_URL="postgresql://USER:PWD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PWD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js ────────────────────────────────────────────────────
# Générer avec : yarn dlx auth secret     (ou : openssl rand -base64 33)
# Signe les cookies de session : quiconque la possède peut forger un jeton et
# se faire passer pour n'importe quel utilisateur. Si elle fuite (log, capture
# d'écran, commit), régénérez-la — toutes les sessions seront invalidées.
AUTH_SECRET=""

# AUTH_URL est volontairement absente.
#
# Auth.js v5 déduit l'hôte des en-têtes de la requête, et active AUTH_TRUST_HOST
# tout seul dès qu'il détecte Vercel : la variable est inutile en local comme en
# production. En définir une casse les preview deployments (hostname variable),
# et si sa valeur n'est pas une URL valide, `new URL()` lève ERR_INVALID_URL
# DANS LE PROXY — ce qui fait tomber toutes les routes du site en 500.

# ── Stockage des photos (Vercel Blob) ──────────────────────────
# Posée automatiquement par l'intégration : Vercel → projet → Storage →
# Create Database → Blob.
# En local, récupérer la valeur avec `vercel env pull` ou la recopier depuis
# les variables du projet. Sans elle, l'ajout de photo affiche un message
# explicite et le reste de l'application fonctionne normalement.
BLOB_READ_WRITE_TOKEN=""

# ── Google OAuth ───────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Redirect URI à déclarer : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Relais OAuth pour les preview deployments (production uniquement, pas en local).
# Sans lui, la connexion Google échoue en preview avec redirect_uri_mismatch :
# chaque preview a un hostname unique que Google ne connaît pas.
# À définir sur Vercel, environnements Production ET Preview :
#   AUTH_REDIRECT_PROXY_URL="https://<domaine-stable>/api/auth"
