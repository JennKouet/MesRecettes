# Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est gitignoré — n'y mettez jamais de secret dans `.env.example`.

# ── Base de données ────────────────────────────────────────────
# DATABASE_URL : utilisé par l'application, via le driver adapter (src/lib/db.ts)
# DIRECT_URL   : utilisé par le CLI Prisma (migrations), via prisma.config.ts
# En local les deux pointent au même endroit ; sur Neon, DATABASE_URL vise
# l'hôte *-pooler* et DIRECT_URL l'hôte direct (sinon `migrate` échoue sur
# des advisory locks).
DATABASE_URL="postgresql://mesrecettes:mesrecettes@localhost:5433/mesrecettes?schema=public"
DIRECT_URL="postgresql://mesrecettes:mesrecettes@localhost:5433/mesrecettes?schema=public"

# Production (Neon) :
# DATABASE_URL="postgresql://USER:PWD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PWD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js ────────────────────────────────────────────────────
# Générer avec : yarn dlx auth secret     (ou : openssl rand -base64 33)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Requis sur Vercel : les preview deployments ont des hostnames variables.
# AUTH_TRUST_HOST="true"

# ── Google OAuth ───────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Redirect URI à déclarer : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
